{
  "name": "healthnova-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173",
    "frontend": "vite --host 0.0.0.0 --port 5173",
    "backend": "powershell -ExecutionPolicy Bypass -File ..\\run-backend.ps1",
    "dev:full": "powershell -ExecutionPolicy Bypass -File ..\\start-healthnova.ps1",
    "dev:attached": "concurrently \"npm run backend\" \"npm run frontend\"",
    "build": "vite build"
  },
  "dependencies": {
    "axios": "^1.13.5",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.3",
    "recharts": "^2.15.4"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.2.1",
    "vite": "^5.4.21"
  }
}
